# ==============================================================================
# HypeSignal Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys and secrets.
# '.env' is ignored by git to protect credentials from accidental exposure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage & Database Settings
# ------------------------------------------------------------------------------
# DuckDB storage path. Use ':memory:' for transient in-memory store or a file path
# such as 'data/hypesignal.duckdb' for persistence across server restarts.
HYPESIGNAL_DB_PATH=:memory:

# ------------------------------------------------------------------------------
# 2. YouTube Data API v3 Connector
# ------------------------------------------------------------------------------
# Google Cloud API key with 'YouTube Data API v3' enabled in Google Cloud Console.
# Leave blank to operate in offline synthetic mock mode.
YOUTUBE_API_KEY=

# Safety budget ceiling for daily quota units (free tier gives 10,000 units/day).
# When this limit is reached, live API calls halt and fall back to mock generation.
YOUTUBE_DAILY_QUOTA_LIMIT=5000

# Token bucket rate limit ceiling (max requests per minute).
YOUTUBE_MAX_RPM=15

# Optional default video ID to monitor if no query is provided (11-character ID).
# e.g., 'dQw4w9WgXcQ'
YOUTUBE_DEFAULT_VIDEO_ID=

# Optional default channel ID to monitor if no query is provided (24-character ID).
# e.g., 'UC_x5XG1OV2P6uZZ5FSM9Ttw'
YOUTUBE_DEFAULT_CHANNEL_ID=

# ------------------------------------------------------------------------------
# 3. Twitter / X Connector (Future Live Ingestion)
# ------------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# 4. Reddit Connector (Future Live Ingestion)
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=HypeSignal/0.1.0

# ------------------------------------------------------------------------------
# 5. Telegram MTProto & Bot API Connector
# ------------------------------------------------------------------------------
# API ID and API Hash from https://my.telegram.org (under API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional App Title and Short Name registered on https://my.telegram.org.
TELEGRAM_APP_TITLE=HypeSignal
TELEGRAM_SHORT_NAME=hypesignal

# Optional Bot token from @BotFather (if authenticating as a bot).
TELEGRAM_BOT_TOKEN=

# Optional Telethon StringSession string (for headless or container authentication).
TELEGRAM_SESSION_STRING=

# Optional session file name (defaults to in-memory session if omitted).
TELEGRAM_SESSION_NAME=

# MTProto Test Environment Configuration.
# Set to 'true' to connect to Telegram's dedicated test servers rather than production.
TELEGRAM_TEST_MODE=false

# Test DC configuration (default test DC is DC 2 at 149.154.167.40:443).
TELEGRAM_TEST_DC_ID=2
TELEGRAM_TEST_DC_IP=149.154.167.40
TELEGRAM_TEST_DC_PORT=443

# Optional path to a file containing MTProto RSA public keys or inline PEM string.
# (Telethon bundles standard production and test keys by default; use this if you have custom keys).
TELEGRAM_PUBLIC_KEYS=

# Comma-separated list of Telegram channel usernames to monitor by default.
# e.g., 'telegram,durov'
TELEGRAM_CHANNELS=

# Token bucket rate limit ceiling (max requests per minute).
TELEGRAM_MAX_RPM=30


# ------------------------------------------------------------------------------
# 6. Bluesky Connector (Future Authenticated Ingestion)
# ------------------------------------------------------------------------------
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
