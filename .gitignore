# ==============================================================================
# HypeSignal Git Ignore Configuration
# ==============================================================================

# Python build, bytecode, and distribution
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing, coverage, and linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Datasets and benchmark corpora
Dataset/
dataset/

# Persistent database files and vector storage
data/*.duckdb
data/*.duckdb.wal
data/*.wal
data/*.tmp
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
qdrant_storage/

# Environment, secrets, and session credentials
.env
.env.*
!.env.example
*.session
*.session-journal
*.pem
*.key

# Editor and OS-specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agent and CLI local customizations
.agents/
skills-lock.json
.gemini/

# Frontend & Node dependencies (for UI development)
node_modules/
.next/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
